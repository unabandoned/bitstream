{
  "compilerOptions": {
    "strict": false,
    "declaration": true,
    "sourceMap": true,
    "module": "CommonJS",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2016",
    "lib": ["DOM", "ES2021"],
    "types": ["node", "reflect-metadata"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/test-setup.ts", "src/benchmark.ts", "src/benchmark-utils.ts"]
}
